<?xml version="1.0" encoding="utf-8"?>
<!-- SURF-5: App Actions custom intents (best-effort: Google is winding App Actions down in favour of
     Gemini / AppFunctions; the deep links and launcher shortcuts are the doors that always work).
     Query patterns are the phrases the Assistant may match; $-slots bind to the capability parameters. -->
<resources>
    <string-array name="app_action_add_to_collection_patterns">
        <item>add this song to $collection</item>
        <item>add this to $collection</item>
        <item>add the current song to $collection</item>
        <item>save this song to $collection</item>
        <item>put this song in $collection</item>
    </string-array>
    <string-array name="app_action_auto_mix_patterns">
        <item>auto mix $source</item>
        <item>auto-mix $source</item>
        <item>auto DJ $source</item>
        <item>start an auto mix of $source</item>
        <item>mix $source automatically</item>
    </string-array>
    <string-array name="app_action_create_pocket_patterns">
        <item>create a pocket of $brief</item>
        <item>create a pocket with $brief</item>
        <item>make a pocket of $brief</item>
        <item>make me a pocket of $brief</item>
        <item>build a pocket of $brief</item>
        <item>create a pocket</item>
    </string-array>
    <string name="app_action_create_pocket_label">Create a pocket from a description</string>
    <string name="app_action_add_to_collection_label">Add this song to a collection</string>
    <string name="app_action_auto_mix_label">Auto-mix a collection</string>
    <string-array name="app_action_set_mix_mode_patterns">
        <item>turn $on mix mode</item>
        <item>turn mix mode $on</item>
        <item>switch $on mix mode</item>
        <item>mix mode $on</item>
    </string-array>
    <string-array name="app_action_mute_stem_patterns">
        <item>mute the $stem</item>
        <item>mute $stem</item>
        <item>turn off the $stem</item>
        <item>kill the $stem</item>
    </string-array>
    <string-array name="app_action_unmute_stem_patterns">
        <item>unmute the $stem</item>
        <item>unmute $stem</item>
        <item>bring back the $stem</item>
    </string-array>
    <string name="app_action_set_mix_mode_label">Turn Mix Mode on or off</string>
    <string name="app_action_mute_stem_label">Mute a stem</string>
    <string name="app_action_unmute_stem_label">Unmute a stem</string>
</resources>
