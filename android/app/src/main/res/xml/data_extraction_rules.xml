<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules. Never leave the device: the settings
  DataStore, the Keystore-backed secrets prefs AND the plaintext credential mirrors
  (settings-credentials / diag-key / rec-key). Also excluded: large rebuildable media
  and caches (burns, catalog-cache, ...), which would push Auto Backup over its 25 MB
  quota so NOTHING (collections, history) was backed up. Small user JSON documents remain.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pocketdj-settings.preferences_pb" />
        <exclude domain="file" path="pocketdj-settings.preferences_pb.tmp" />
        <exclude domain="file" path="pocketdj-in-the-pocket.json" />
        <exclude domain="file" path="pocketdj-in-the-pocket.json.tmp" />
        <exclude domain="file" path="pocketdj-in-the-pocket-sync.json" />
        <exclude domain="file" path="pocketdj-in-the-pocket-sync.json.tmp" />
        <exclude domain="file" path="pocketdj-listening-places.json" />
        <exclude domain="file" path="pocketdj-listening-places.json.tmp" />
        <exclude domain="file" path="pocketdj-settings-credentials.json" />
        <exclude domain="file" path="pocketdj-settings-credentials.json.tmp" />
        <exclude domain="file" path="pocketdj-settings-credentials.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-settings-credentials.json.pull.tmp" />
        <exclude domain="file" path="pocketdj-diag-key.json" />
        <exclude domain="file" path="pocketdj-diag-key.json.tmp" />
        <exclude domain="file" path="pocketdj-diag-key.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-diag-key.json.pull.tmp" />
        <exclude domain="file" path="pocketdj-rec-key.json" />
        <exclude domain="file" path="pocketdj-rec-key.json.tmp" />
        <exclude domain="file" path="pocketdj-rec-key.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-rec-key.json.pull.tmp" />
        <exclude domain="file" path="pocketdj-cloudsync-state.json" />
        <exclude domain="file" path="pocketdj-cloudsync-state.json.tmp" />
        <exclude domain="file" path="pocketdj-cloudsync-state.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-cloudsync-state.json.pull.tmp" />
        <exclude domain="file" path="pocketdj-endpoints.json" />
        <exclude domain="file" path="pocketdj-endpoints.json.tmp" />
        <exclude domain="file" path="pocketdj-endpoints.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-endpoints.json.pull.tmp" />
        <exclude domain="sharedpref" path="pocketdj-secrets.xml" />
        <exclude domain="file" path="burns" />
        <exclude domain="file" path="burns-user" />
        <exclude domain="file" path="catalog-cache" />
        <exclude domain="file" path="rips-cache" />
        <exclude domain="file" path="demux-cache" />
        <exclude domain="file" path="diag-captures" />
        <exclude domain="file" path="lyrics-cache" />
        <exclude domain="file" path="lyrics" />
        <exclude domain="file" path="studio" />
        <exclude domain="file" path="mix-sessions" />
        <exclude domain="file" path="widget" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pocketdj-settings.preferences_pb" />
        <exclude domain="file" path="pocketdj-settings.preferences_pb.tmp" />
        <exclude domain="file" path="pocketdj-in-the-pocket.json" />
        <exclude domain="file" path="pocketdj-in-the-pocket.json.tmp" />
        <exclude domain="file" path="pocketdj-in-the-pocket-sync.json" />
        <exclude domain="file" path="pocketdj-in-the-pocket-sync.json.tmp" />
        <exclude domain="file" path="pocketdj-listening-places.json" />
        <exclude domain="file" path="pocketdj-listening-places.json.tmp" />
        <exclude domain="file" path="pocketdj-settings-credentials.json" />
        <exclude domain="file" path="pocketdj-settings-credentials.json.tmp" />
        <exclude domain="file" path="pocketdj-settings-credentials.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-settings-credentials.json.pull.tmp" />
        <exclude domain="file" path="pocketdj-diag-key.json" />
        <exclude domain="file" path="pocketdj-diag-key.json.tmp" />
        <exclude domain="file" path="pocketdj-diag-key.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-diag-key.json.pull.tmp" />
        <exclude domain="file" path="pocketdj-rec-key.json" />
        <exclude domain="file" path="pocketdj-rec-key.json.tmp" />
        <exclude domain="file" path="pocketdj-rec-key.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-rec-key.json.pull.tmp" />
        <exclude domain="file" path="pocketdj-cloudsync-state.json" />
        <exclude domain="file" path="pocketdj-cloudsync-state.json.tmp" />
        <exclude domain="file" path="pocketdj-cloudsync-state.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-cloudsync-state.json.pull.tmp" />
        <exclude domain="file" path="pocketdj-endpoints.json" />
        <exclude domain="file" path="pocketdj-endpoints.json.tmp" />
        <exclude domain="file" path="pocketdj-endpoints.json.pre-cloud" />
        <exclude domain="file" path="pocketdj-endpoints.json.pull.tmp" />
        <exclude domain="sharedpref" path="pocketdj-secrets.xml" />
        <exclude domain="file" path="burns" />
        <exclude domain="file" path="burns-user" />
        <exclude domain="file" path="catalog-cache" />
        <exclude domain="file" path="rips-cache" />
        <exclude domain="file" path="demux-cache" />
        <exclude domain="file" path="diag-captures" />
        <exclude domain="file" path="lyrics-cache" />
        <exclude domain="file" path="lyrics" />
        <exclude domain="file" path="studio" />
        <exclude domain="file" path="mix-sessions" />
        <exclude domain="file" path="widget" />
    </device-transfer>
</data-extraction-rules>
