<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup / device-transfer rules. The settings DataStore
  now holds Apple Music secrets (the ~6-month Music-User-Token and the app-wide
  ES256 developer token — AppSettingsStore Keys.MUSIC_USER_TOKEN / AM_DEV_TOKEN),
  so its .preferences_pb must never leave the device via Auto Backup (Google
  Drive) or device-to-device transfer. Everything else still backs up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="pocketdj-settings.preferences_pb" />
        <exclude domain="file" path="pocketdj-settings.preferences_pb.tmp" />
        <exclude domain="sharedpref" path="pocketdj-secrets.xml" />
        <exclude domain="file" path="pocketdj-in-the-pocket.json" />
        <exclude domain="file" path="pocketdj-in-the-pocket.json.tmp" />
        <exclude domain="file" path="pocketdj-in-the-pocket-sync.json" />
        <exclude domain="file" path="pocketdj-in-the-pocket-sync.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pocketdj-settings.preferences_pb" />
        <exclude domain="file" path="pocketdj-settings.preferences_pb.tmp" />
        <exclude domain="sharedpref" path="pocketdj-secrets.xml" />
        <exclude domain="file" path="pocketdj-in-the-pocket.json" />
        <exclude domain="file" path="pocketdj-in-the-pocket.json.tmp" />
        <exclude domain="file" path="pocketdj-in-the-pocket-sync.json" />
        <exclude domain="file" path="pocketdj-in-the-pocket-sync.json.tmp" />
    </device-transfer>
</data-extraction-rules>
