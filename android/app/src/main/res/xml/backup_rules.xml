    <exclude domain="file" path="pocketdj-endpoints.json" />
    <exclude domain="file" path="pocketdj-endpoints.json.tmp" />
    <exclude domain="file" path="pocketdj-endpoints.json.pre-cloud" />
    <exclude domain="file" path="pocketdj-endpoints.json.pull.tmp" />
    <exclude domain="sharedpref" path="pocketdj-secrets.xml" />
    <exclude domain="file" path="burns" />
