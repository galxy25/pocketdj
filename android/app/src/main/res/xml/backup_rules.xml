<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 Auto Backup rules; mirrors data_extraction_rules.xml (credentials,
  mirrors and large media/caches excluded so the backup fits the 25 MB quota).
-->
<full-backup-content>
    <exclude domain="file" path="pocketdj-settings.preferences_pb" />
    <exclude domain="file" path="pocketdj-settings.preferences_pb.tmp" />
    <exclude domain="file" path="pocketdj-in-the-pocket.json" />
    <exclude domain="file" path="pocketdj-in-the-pocket.json.tmp" />
    <exclude domain="file" path="pocketdj-in-the-pocket-sync.json" />
    <exclude domain="file" path="pocketdj-in-the-pocket-sync.json.tmp" />
