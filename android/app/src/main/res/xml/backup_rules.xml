    <exclude domain="file" path="pocketdj-listening-places.json.tmp" />
    <exclude domain="file" path="pocketdj-settings-credentials.json" />
    <exclude domain="file" path="pocketdj-settings-credentials.json.tmp" />
    <exclude domain="file" path="pocketdj-settings-credentials.json.pre-cloud" />
    <exclude domain="file" path="pocketdj-settings-credentials.json.pull.tmp" />
    <exclude domain="file" path="pocketdj-diag-key.json" />
    <exclude domain="file" path="pocketdj-diag-key.json.tmp" />
    <exclude domain="file" path="pocketdj-diag-key.json.pre-cloud" />
    <exclude domain="file" path="pocketdj-diag-key.json.pull.tmp" />
