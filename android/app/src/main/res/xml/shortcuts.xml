<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts (iOS App Shortcuts analogue). Handled by MediaSearchIntentHandler
     (ACTION_OPEN_TAB). Keep ShortcutManagerSink.STATIC_COUNT equal to the number of entries. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <shortcut
        android:shortcutId="open_collections"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_collections_short"
        android:shortcutLongLabel="@string/shortcut_collections_long">
        <intent
            android:action="com.levi.pocketdj.action.OPEN_TAB"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity">
            <extra android:name="tab" android:value="playlists" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="open_browse"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_browse_short"
        android:shortcutLongLabel="@string/shortcut_browse_long">
        <intent
            android:action="com.levi.pocketdj.action.OPEN_TAB"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity">
            <extra android:name="tab" android:value="browse" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="open_mix"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_mix_short"
        android:shortcutLongLabel="@string/shortcut_mix_long">
        <intent
            android:action="com.levi.pocketdj.action.OPEN_TAB"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity">
            <extra android:name="tab" android:value="mix" />
        </intent>
    </shortcut>
    <!-- P2-POC-16: "Play my pocket" plays the Pocket Wheel's best match for now (pocketdj://pocket/now). -->
    <shortcut
        android:shortcutId="play_pocket_now"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_pocket_now_short"
        android:shortcutLongLabel="@string/shortcut_pocket_now_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="pocketdj://pocket/now"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity" />
    </shortcut>
    <!-- SURF-5 App Actions custom intents. Best-effort (App Actions is being wound down); both fulfil through
         the same pocketdj:// deep links. Capabilities are not shortcuts: STATIC_COUNT is unchanged. -->
    <capability
        android:name="custom.actions.intent.ADD_TO_COLLECTION"
        app:queryPatterns="@array/app_action_add_to_collection_patterns">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity">
            <url-template android:value="pocketdj://add{?collection}" />
            <parameter android:name="collection" android:key="collection" android:required="true" />
        </intent>
    </capability>
    <capability
        android:name="custom.actions.intent.AUTO_MIX"
        app:queryPatterns="@array/app_action_auto_mix_patterns">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity">
            <url-template android:value="pocketdj://automix{/kind}{/id}" />
            <parameter android:name="kind" android:key="kind" android:required="true" />
            <parameter android:name="id" android:key="id" android:required="true" />
        </intent>
    </capability>
    <!-- SURF-10: Mix Mode + stems by voice, through pocketdj://np/... -->
    <capability
        android:name="custom.actions.intent.SET_MIX_MODE"
        app:queryPatterns="@array/app_action_set_mix_mode_patterns">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity">
            <url-template android:value="pocketdj://np/mixmode{?on}" />
            <parameter android:name="on" android:key="on" android:required="true" />
        </intent>
    </capability>
    <capability
        android:name="custom.actions.intent.MUTE_STEM"
        app:queryPatterns="@array/app_action_mute_stem_patterns">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity">
            <url-template android:value="pocketdj://np/stem{/stem}?mute=1" />
            <parameter android:name="stem" android:key="stem" android:required="true" />
        </intent>
    </capability>
    <capability
        android:name="custom.actions.intent.UNMUTE_STEM"
        app:queryPatterns="@array/app_action_unmute_stem_patterns">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.levi.pocketdj"
            android:targetClass="com.levi.pocketdj.MainActivity">
            <url-template android:value="pocketdj://np/stem{/stem}?mute=0" />
            <parameter android:name="stem" android:key="stem" android:required="true" />
        </intent>
    </capability>
</shortcuts>
