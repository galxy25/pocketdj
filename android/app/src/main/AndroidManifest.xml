<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Decision D4: declared once in wave 1. None is requested at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />

    <application
        android:name=".PocketDjApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketDJ">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PocketDJ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- SVC-5: open a .pdjdiagkey file from Files (diag-writer key import). -->
            <!-- Files/Downloads hand out opaque content:// URIs (no filename in the path), so
                 match on scheme + MIME only; DiagServices.deepLink checks DISPLAY_NAME. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/json" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- file:// URIs do carry the name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.pdjdiagkey" />
            </intent-filter>
            <!-- SURF-4: pocketdj:// custom scheme. Scheme-only so both pocketdj://jukebox/<id> and the
                 host-less pocketdj:///jukebox/<id> match; DeepLinkParser validates verbs
                 (play, album, artist, playlist, pocket, setlist, jukebox, mwf, search). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pocketdj" />
            </intent-filter>
            <!-- SURF-4: App Links for jukebox guest pages and /mwf/<id>/ (autoVerify needs
                 assetlinks.json on the website: device-only). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="jukebox.pocket-dj.com" />
                <data android:pathPrefix="/" />
            </intent-filter>
            <!-- SURF-4: collection files by MIME (content://) ... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-pocketdj-collection" />
            </intent-filter>
            <!-- ... and by extension (.pdjcollection / .pocketdj.zip) where the path carries a name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.pdjcollection" />
                <data android:pathPattern=".*\\..*\\.pdjcollection" />
                <data android:pathPattern=".*\\.pocketdj\\.zip" />
                <data android:pathPattern=".*\\..*\\.pocketdj\\.zip" />
            </intent-filter>
            <!-- Static shortcuts (filled by SURF-9); empty today. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- SVC-3: WorkManager's foreground service must declare a type for long-running burn downloads. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- REQUIRED on Android 12+ or the manifest merge fails (specs/applemusic.md
             §2): the auth library declares this activity WITH an <intent-filter>
             but no explicit android:exported, illegal on targetSdk >= 31. This
             attribute-only override lets the merger keep the library's deep-link
             filter (musicsdk://com.levi.pocketdj/authenticateresult...) while
             supplying the missing exported flag. It MUST be exported="true": the
             filter is BROWSABLE and the Apple Music app (a separate process)
             redirects the sign-in result into it, which an implicit cross-app
             intent can only reach on an exported activity (targetSdk 31+). With
             exported="false" the redirect is dropped and sign-in silently never
             completes on device. -->
        <activity
            android:name="com.apple.android.sdk.authentication.SDKUriHandlerActivity"
            android:exported="true" />
    </application>

</manifest>
