{
  "name": "pocketdj",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PocketDJ - Portable, Personal, Musical Performance Playlists Producer. An offline-first PWA that puts a DJ in your pocket.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:mock": "tsx scripts/generate-mock-index.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "indexer:parser-test": "node .claude/skills/analog-indexer/lib/parser.test.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1"
  }
}
