<?xml version="1.0" encoding="UTF-8"?>
<!--
  PocketDJ Apple-Music nightly sync — launchd timer TEMPLATE.

  Install/refresh with:  scripts/install-am-sync-nightly.sh
  (fills __LAUNCHER__ / __HOME__, copies to ~/Library/LaunchAgents, reloads the job).

  Points at the STABLE launcher in ~/.pocketdj/bin — never at a checkout — so whatever
  branch the dev repo is on at 04:00 is irrelevant. The launcher hands off to the
  dedicated sync clone (~/.pocketdj/am-sync-clone), which always runs origin/main:
  diff the live Music library against the committed index (am-incremental-sync), and if
  anything changed, commit + push, deploy S3 dev+prod, refresh online search. A no-change
  night is a true no-op (deploy marker checked). RunAtLoad stays false so (re)loading
  the job doesn't fire a run.

  This REPLACES the rip server's in-process 04:00 am-check (disabled) and the old
  change-set → full-rebuild am-sync-agent. Do NOT run both: this owns 04:00.

  Stop:     launchctl unload ~/Library/LaunchAgents/com.pocketdj.am-sync-nightly.plist
  Preview:  scripts/am-sync-nightly.sh with the dry-run flag (no clone/commit/deploy).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pocketdj.am-sync-nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__LAUNCHER__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AWS_PROFILE</key>
    <string>levi</string>
    <!-- launchd has a minimal PATH; include node, npm, aws, git, osascript locations. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- 04:00 daily. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/.pocketdj/am-sync-nightly.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.pocketdj/am-sync-nightly.err.log</string>
</dict>
</plist>
