<?xml version="1.0" encoding="UTF-8"?>
<!--
  PocketDJ "My Digital" nightly indexer — launchd timer TEMPLATE.

  Install/refresh with:  scripts/install-digital-sync-nightly.sh
  (fills __LAUNCHER__ / __HOME__, copies to ~/Library/LaunchAgents, reloads the job).

  Points at the STABLE launcher in ~/.pocketdj/bin — never at a checkout — so whatever
  branch the dev repo is on at 05:00 is irrelevant. The launcher hands off to the dedicated
  sync clone (~/.pocketdj/digital-sync-clone), which always runs origin/main: walk the burn
  root (/Volumes/RipBurnMix/Pocket DJ), index ONLY new album folders (transcode/analyze/
  upload skip already-done work via ~/.pocketdj/digital), and if anything changed commit +
  push, publish the index to the dev web bucket, refresh online search, and kick a stem
  backfill. A no-change night is a true no-op (publish marker checked). RunAtLoad stays
  false so (re)loading the job doesn't fire a run.

  05:00 — one hour AFTER the Apple Music nightly (04:00) so they never contend for the
  git clone lock or the deploy pipeline.

  Stop:     launchctl unload ~/Library/LaunchAgents/com.pocketdj.digital-sync-nightly.plist
  Preview:  scripts/digital-sync-nightly.sh --dry-run  (no clone/commit/publish).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pocketdj.digital-sync-nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__LAUNCHER__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>AWS_PROFILE</key>
    <string>levi</string>
    <!-- launchd has a minimal PATH; include node, npm, aws, git, ffmpeg, docker locations. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- 05:00 daily (after the 04:00 Apple Music nightly). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>5</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/.pocketdj/digital-sync-nightly.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.pocketdj/digital-sync-nightly.err.log</string>
</dict>
</plist>
