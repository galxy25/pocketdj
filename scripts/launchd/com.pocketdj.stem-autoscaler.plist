<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the PocketDJ stem-worker autoscaler. Runs scripts/stem-autoscaler.mjs every
  60s: reads the SQS jobs-queue depth and launches cloud stem workers (up to the vCPU-quota cap)
  when there's a backlog. Workers self-retire on idle, so the fleet drains to zero — this agent
  only ever scales UP. Pairs with the rip server, which enqueues stem jobs to the same SQS queue.

  Install:
    cp scripts/launchd/com.pocketdj.stem-autoscaler.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.pocketdj.stem-autoscaler.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.pocketdj.stem-autoscaler.plist
  Logs:  ~/.pocketdj/stem-autoscaler.log
  Stop:  launchctl unload ~/Library/LaunchAgents/com.pocketdj.stem-autoscaler.plist

  Uses the `levi` AWS profile (SQS + EC2 run-instances on the pocketdj-stem-worker launch template).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pocketdj.stem-autoscaler</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/deepspacenine/forges/levi/pocketdj/scripts/stem-autoscaler.mjs</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>AWS_PROFILE</key>
    <string>levi</string>
    <key>HOME</key>
    <string>/Users/deepspacenine</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/deepspacenine/forges/levi/pocketdj</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/deepspacenine/.pocketdj/stem-autoscaler.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/deepspacenine/.pocketdj/stem-autoscaler.log</string>
</dict>
</plist>
