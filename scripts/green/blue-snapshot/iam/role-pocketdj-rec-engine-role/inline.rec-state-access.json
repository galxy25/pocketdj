{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::pocketdj-rec-011183829623/rec/*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::pocketdj-rec-011183829623",
      "Condition": {
        "StringLike": {
          "s3:prefix": "rec/*"
        }
      }
    }
  ]
}
