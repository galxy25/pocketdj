{
  "Version": "2012-10-17",
  "Id": "default",
  "Statement": [
    {
      "Sid": "fnurl-public",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "lambda:InvokeFunctionUrl",
      "Resource": "arn:aws:lambda:us-west-2:011183829623:function:pocketdj-search-proxy",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionUrlAuthType": "NONE"
        }
      }
    },
    {
      "Sid": "apigw-invoke",
      "Effect": "Allow",
      "Principal": {
        "Service": "apigateway.amazonaws.com"
      },
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:us-west-2:011183829623:function:pocketdj-search-proxy",
      "Condition": {
        "ArnLike": {
          "AWS:SourceArn": "arn:aws:execute-api:us-west-2:011183829623:fnlg100ir5/*"
        }
      }
    }
  ]
}
