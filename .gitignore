# dependencies
node_modules/

# audio indexer python virtualenv (large, host-local)
.venv-audio/

# burned setlists (large host-local audio carved from raw rips by burn-setlist)
/burned-setlists/
/1 — take 3/

# ripped setlists (large host-local audio recorded from Apple Music by the rip skill)
*_ripped/

# per-setlist generated artifacts (match/backfill outputs; regenerable, host-local)
/* - apple-music.csv
/* - backfill.csv
/* - backfill.json

# build output
dist/
dist-ssr/
*.local

# editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# PWA generated
dev-dist/

# indexer raw outputs are large; keep the curated index.json (see index-out/.gitignore)

# TypeScript build info
*.tsbuildinfo

# playwright MCP scratch + ad-hoc verification screenshots (root-level pngs only;
# committed proof artifacts live under tests/e2e/proof/)
.playwright-mcp/
/*.png
/scaffold-boot.png
/browser-albums.png
/starmap.png
/solar-system.png
