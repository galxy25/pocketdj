/dev-imported.png
/current-index.png
/current-browse.png
/current-starmap.png
/covers-test.png
/current-clean.png

# Xcode code-coverage scratch (written when running tests from the repo root)
*.profraw

# scale-to-zero A/B runtime artifacts
.aoss-sz-endpoint.txt
.aoss-sz-watch.log
.aoss-prod-endpoint.txt
.aoss-proxy-url.txt
.aoss-proxy-api.txt
.worktrees/
scripts/lambda/am-playlist-sync/.endpoint-url.txt
scripts/lambda/rec-engine/.endpoint-url.txt

# Apple Music LIFETIME play-count snapshot (playcounts.json / *-playcounts.json).
# PRIVATE listening history — 56k rows of what the owner actually plays. It is imported into a
# DEVICE-LOCAL store (AMPlayBaselineStore) on purpose and must never reach the shared catalog or
# git: public/apple-music-index.json is ONE document every install subscribes to, so anything
# committed near it risks publishing this to every other user.
/playcounts.json
*-playcounts.json

# diag key must never be compiled in or tracked (lives in Keychain; see DiagCredentialStore)
apple/PocketDJ/Support/DiagSecret*.swift
scripts/gen-diag-secret.sh
