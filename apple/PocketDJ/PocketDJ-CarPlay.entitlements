<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CarPlay entitlements — applied to BOTH iOS SDKs (device + simulator) via project.yml
  (CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*] and [sdk=iphonesimulator*]).

  `com.apple.developer.carplay-audio` lets an audio app present CarPlay templates on a
  head unit. The CarPlay Audio App capability is GRANTED + enabled on the App ID
  (com.levi.pocketdj) — verified in the Developer portal — so device/TestFlight builds
  sign green with it (it's in the provisioning profile). It lives in this iOS-scoped file
  rather than the base PocketDJ.entitlements because the base also covers visionOS, which
  has no CarPlay and would reject the key.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.carplay-audio</key>
    <true/>
    <!-- App Group shared with the Now Playing widget extension (PocketDJWidgets). This file
         is the iOS-device/simulator entitlements, so the group must be declared HERE for iOS
         (the base file only reaches visionOS). Same group id across all three app files. -->
    <key>com.apple.security.application-groups</key>
    <array>
      <string>group.com.levi.pocketdj</string>
    </array>
    <!-- CloudKit (user profiles + session-data sync, CloudSyncService). The ICLOUD
         capability is enabled on the App ID (done via the ASC API); the container is
         registered by Xcode automatic signing (-allowProvisioningUpdates) on first
         device/archive build. Same container id in all three app entitlement files. -->
    <key>com.apple.developer.icloud-services</key>
    <array>
      <string>CloudKit</string>
    </array>
    <key>com.apple.developer.icloud-container-identifiers</key>
    <array>
      <string>iCloud.com.levi.pocketdj</string>
    </array>
</dict>
</plist>
