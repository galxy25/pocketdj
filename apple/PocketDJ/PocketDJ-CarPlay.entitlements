<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CarPlay entitlements — applied to the iOS SIMULATOR SDK ONLY (see project.yml).

  `com.apple.developer.carplay-audio` is what lets an audio app present CarPlay
  templates on a head unit. It requires Apple to GRANT the CarPlay App Service on the
  App ID (com.levi.pocketdj) before a device/TestFlight build can sign with it, so it is
  scoped to the simulator here (the CarPlay Simulator ignores code signing). When Apple
  grants the capability, add this key to the base PocketDJ.entitlements instead.
-->
<plist version="1.0">
<dict>
    <key>com.apple.developer.carplay-audio</key>
    <true/>
</dict>
</plist>
