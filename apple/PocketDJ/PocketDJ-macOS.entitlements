<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS App Sandbox entitlements — REQUIRED for Mac App Store / TestFlight.

  The iOS build keeps the (empty) PocketDJ.entitlements; this file is wired ONLY for
  the macOS SDK via `CODE_SIGN_ENTITLEMENTS[sdk=macosx*]` in project.yml.

  Only the capabilities PocketDJ actually exercises on the Mac:
  • network.client            — HTTPS to the rip server, S3 rips bucket, CloudFront,
                                OpenSearch, MusicKit/iTunes. (Outgoing only; the app
                                runs no local server — that's the separate rip server.)
  • files.user-selected.read-write — the user-picked burn/download folder (security-
                                scoped bookmark). The analog source on /Volumes/RipBurnMix
                                is a rip-SERVER concern, not the app, so no removable
                                volume entitlement is needed here.
  • device.audio-input        — the "?♪?" ShazamKit recognizer's mic capture
                                (paired with INFOPLIST_KEY_NSMicrophoneUsageDescription).

  MusicKit/ShazamKit need NO entitlement KEY here — the MusicKit App Service lives on the
  App ID (com.levi.pocketdj). If MusicKit playback misbehaves under the sandbox, revisit.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Bluetooth (I3) — the app is a CoreBluetooth central: it scans for and connects BLE MIDI
       keyboards itself (BLEMIDIManager), so the sandbox needs the Bluetooth device entitlement. -->
  <key>com.apple.security.device.bluetooth</key>
  <true/>
  <!-- App Group shared with the Now Playing widget extension (PocketDJWidgets). Under the
       macOS App Sandbox an app group grants access to the shared container the widget reads. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.levi.pocketdj</string>
  </array>
  <!-- CloudKit (user profiles + session-data sync, CloudSyncService) — works under the
       App Sandbox; same container id as the iOS/visionOS entitlement files. -->
  <key>com.apple.developer.icloud-services</key>
  <array>
    <string>CloudKit</string>
  </array>
  <key>com.apple.developer.icloud-container-identifiers</key>
  <array>
    <string>iCloud.com.levi.pocketdj</string>
  </array>
  <!-- Universal Links (jukebox join) — macOS. Associated Domains capability is enabled on the
       App ID; AASA hosted at jukebox.pocket-dj.com. See the base PocketDJ.entitlements for the
       full note. Works under the App Sandbox. Same key across all three app files. -->
  <key>com.apple.developer.associated-domains</key>
  <array>
    <string>applinks:jukebox.pocket-dj.com</string>
  </array>
</dict>
</plist>
