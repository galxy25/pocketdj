<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PocketDJ entitlements — intentionally EMPTY.

  Neither MusicKit nor ShazamKit uses a `.entitlements` key:
  • MusicKit — enabled by the MusicKit App Service on the App ID (`com.levi.pocketdj`,
    team EC27UF79GL) + NSAppleMusicUsageDescription.
  • ShazamKit — needs only NSMicrophoneUsageDescription + the framework (it ships with
    the OS); the public Shazam catalog requires no entitlement.
  Declaring `com.apple.developer.musickit` / `com.apple.developer.shazamkit` here is
  invalid and breaks signing ("not found and could not be included in profile") — that
  was the original build error. Add a key only if a future capability genuinely needs one.
-->
<plist version="1.0">
<dict>
</dict>
</plist>
