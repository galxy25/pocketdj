<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  PocketDJ entitlements — intentionally EMPTY.

  MusicKit and ShazamKit do NOT use a `.entitlements` file key. They are enabled by
  turning on the matching App Service for the App ID (`com.levi.pocketdj`, team
  EC27UF79GL) in the Apple Developer portal, together with the Info.plist usage
  strings (NSAppleMusicUsageDescription for MusicKit, NSMicrophoneUsageDescription
  for ShazamKit). Declaring `com.apple.developer.musickit` /
  `com.apple.developer.shazamkit` here is NOT a valid provisionable entitlement and
  breaks device/distribution signing ("not found and could not be included in
  profile"). The MusicKit App Service + usage string are sufficient for
  MusicAuthorization + ApplicationMusicPlayer; re-add real entitlements here only if
  a future capability (push, app groups, …) genuinely needs one.
-->
<plist version="1.0">
<dict>
</dict>
</plist>
