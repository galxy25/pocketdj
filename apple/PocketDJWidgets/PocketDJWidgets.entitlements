<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Now Playing widget extension entitlements (iOS + visionOS SDKs). The widget reads the
  shared now-playing snapshot + cover from the App Group container the app writes. macOS
  uses the sibling PocketDJWidgets-macOS.entitlements (App Sandbox + the same group).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.levi.pocketdj</string>
  </array>
</dict>
</plist>
