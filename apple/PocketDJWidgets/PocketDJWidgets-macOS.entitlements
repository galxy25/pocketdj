<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Now Playing widget extension entitlements (macOS SDK). A macOS app extension must be
  sandboxed; the App Group grants access to the shared container the app writes the
  now-playing snapshot + cover into.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.levi.pocketdj</string>
  </array>
</dict>
</plist>
